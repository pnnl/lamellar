  { $as_echo "$as_me:${as_lineno-$LINENO}: result: no" >&5
$as_echo "no" >&6; }
                         CFLAGS="$SAVE_CFLAGS"
                         CXXFLAGS="$SAVE_CXXFLAGS"
                         LDFLAGS_DYNAMIC_LIST_DATA="-Wl,-export-dynamic"
fi
