$as_echo "$as_me: WARNING: $arg of $with_rocm not parsed" >&2;}
fi ;; #(
  *) :
    { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: $arg of $with_rocm not parsed" >&5
$as_echo "$as_me: WARNING: $arg of $with_rocm not parsed" >&2;} ;;
esac
done ;;
esac

    SAVE_CPPFLAGS="$CPPFLAGS"
    SAVE_LDFLAGS="$LDFLAGS"
    SAVE_LIBS="$LIBS"

