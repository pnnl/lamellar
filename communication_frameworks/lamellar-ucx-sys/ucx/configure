         { $as_echo "$as_me:${as_lineno-$LINENO}: checking compiler flag -fsanitize=address -fno-omit-frame-pointer" >&5
$as_echo_n "checking compiler flag -fsanitize=address -fno-omit-frame-pointer... " >&6; }
         SAVE_CFLAGS="$CFLAGS"
         SAVE_CXXFLAGS="$CXXFLAGS"
         CFLAGS="$BASE_CFLAGS $CFLAGS -fsanitize=address -fno-omit-frame-pointer"
         CXXFLAGS="$BASE_CXXFLAGS $CXXFLAGS -fsanitize=address -fno-omit-frame-pointer"
         cat confdefs.h - <<_ACEOF >conftest.$ac_ext
