    ptmalloc286)
        { $as_echo "$as_me:${as_lineno-$LINENO}: Memory allocator is ptmalloc-2.8.6 version" >&5
$as_echo "$as_me: Memory allocator is ptmalloc-2.8.6 version" >&6;}

