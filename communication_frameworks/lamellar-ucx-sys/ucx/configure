  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_run "$LINENO"; then :
  as_fn_error $? "ASAN cannot detect simple memory leak, consider installing newer compiler version" "$LINENO" 5
else
  { $as_echo "$as_me:${as_lineno-$LINENO}: sanitizer runtime leak detection check passed" >&5
$as_echo "$as_me: sanitizer runtime leak detection check passed" >&6;}

